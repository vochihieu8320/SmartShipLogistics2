# Database Configuration
# ----------------------
# Required: Connection string for PostgreSQL database
DATABASE_URL=postgres://username:password@hostname:port/database

# Optional: Enable SSL for database connection (default: false)
DB_SSL=false

# Optional: Maximum number of connections in pool (default: 20)
DB_MAX_CONNECTIONS=20

# Optional: Idle timeout in milliseconds (default: 30000)
DB_IDLE_TIMEOUT=30000

# Session Configuration
# ----------------------
# Required in production: Secret key for signing session cookies
SESSION_SECRET=your-session-secret-key

# Optional: Session table name in database (default: 'session')
SESSION_TABLE_NAME=session

# Optional: Session cookie max age in milliseconds (default: 24 hours)
SESSION_MAX_AGE=86400000

# Optional: Force secure cookies even in development
FORCE_SECURE_COOKIES=false

# Server Configuration
# ----------------------
# Optional: Port to listen on (default: 5000)
PORT=5000

# Optional: Environment (development, production, test) (default: development)
NODE_ENV=development

# Optional: Trust proxy settings for reverse proxies (default: false)
TRUST_PROXY=false

# Auth Configuration
# ----------------------
# Optional: Bcrypt rounds for password hashing (default: 10)
PASSWORD_HASH_ROUNDS=10