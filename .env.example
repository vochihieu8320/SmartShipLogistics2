# SmartShip Pro Environment Configuration
# -----------------------------
# Copy this file to .env and fill in your environment-specific values

# Database Configuration (Optional)
# If not set, the application will use in-memory storage
# -----------------------------
# DATABASE_URL=postgres://user:password@host:port/database
# DB_SSL=true
# DB_MAX_CONNECTIONS=20
# DB_IDLE_TIMEOUT=30000

# Session Configuration
# -----------------------------
# Required in production: Secret for signing session cookies
SESSION_SECRET=replace-with-secure-random-string
SESSION_TABLE_NAME=session
SESSION_MAX_AGE=86400000
# FORCE_SECURE_COOKIES=true

# Server Configuration
# -----------------------------
PORT=5000
NODE_ENV=development
# TRUST_PROXY=true  # For running behind reverse proxies

# Auth Configuration
# -----------------------------
PASSWORD_HASH_ROUNDS=10

# API Configuration
# -----------------------------
# Whether to use the external API (true by default)
USE_EXTERNAL_API=true
# External API endpoint URL
EXTERNAL_API_URL=https://f155-103-249-22-81.ngrok-free.app/api/v1
# API key for external authentication (if required)
# EXTERNAL_API_KEY=your-api-key-if-needed